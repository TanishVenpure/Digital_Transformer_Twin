APP_NAME=Digital Transformer Twin API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/digital_transformer
# Required for agent, data, alert, maintenance, transformer and simulation routes.
# Format: scope[,scope...]:secret;scope:another-secret
# A scope is a transformer ID, or a permission starting with "@":
#   (none)      transformer IDs only = read access + agent chat/events; no writes
#   @ingest     POST /data/* and POST /maintenance/records for its transformers
#   @alerts     acknowledge/resolve alerts of its transformers
#   @simulation the shared simulator; grants no transformer data
# Writes need the permission AND the transformer in the same key's scope.
# Misspelled permissions grant nothing. Use a separate key per role.
AGENT_CREDENTIALS=TX-001:replace-with-a-chat-secret;TX-001,@ingest:replace-with-an-ingest-secret;TX-001,@alerts:replace-with-an-alerts-secret;@simulation:replace-with-a-simulation-secret

# Optional AI explanations in /api/v1/agent/chat. "none" (default) keeps answers
# deterministic. "gemini" sends the question, deterministic risk assessment and
# maintenance evidence to Google Gemini; the risk engine stays authoritative.
LLM_PROVIDER=none
GEMINI_API_KEY=
# Verified live with gemini-3.8-flash; the code default gemini-2.5-flash is closed to new users.
GEMINI_MODEL=gemini-3.8-flash
# Also the server-side deadline; Google returns 504 DEADLINE_EXCEEDED past it.
GEMINI_TIMEOUT_SECONDS=30
# low | medium | high | default. gemini-3.8-flash supports low/medium/high (not minimal).
GEMINI_THINKING_LEVEL=low
